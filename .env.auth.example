# Copy to .env.auth for `docker compose --profile proxy up -d`. Configuration of
# https://github.com/vilmis04/auth-proxy, see its README. Never commit .env.auth.
PORT=4300
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3300
# The proxy forwards to the service by its compose service name.
SERVICE_URL=http://go-service:4200
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=evgame
POSTGRES_PASSWORD=evgame
POSTGRES_DB=evgame
# Same value as INTERNAL_TOKEN in .env. The service rejects every request without it,
# so the proxy has to send it as the X-Internal-Token header (see README).
INTERNAL_TOKEN=change-me-local-token
