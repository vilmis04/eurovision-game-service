# Copy to .env for local development: cp .env.example .env
# `make run` and docker compose read this file. Never commit .env or real secrets.

# --- service ---
# Port the service listens on (required, there is no default).
PORT=4200
# Shared secret that the auth proxy sends in the X-Internal-Token header (required).
INTERNAL_TOKEN=change-me-local-token
# HMAC key that signs group invites (required). Changing it invalidates open invites.
INVITE_SECRET=change-me-local-invite-secret
# Comma separated user ids allowed to create, update and delete countries.
ADMIN_USERS=

# --- database ---
# Connection URL (required). With `make run` the database is reached through the
# port that compose publishes on localhost.
DATABASE_URL=postgres://evgame:evgame@localhost:5432/evgame
# sslmode when the URL has none: disable | allow | prefer | require | verify-ca | verify-full
# The compose database has no TLS, so local development uses disable. Default: require.
DB_SSLMODE=disable
# Pool tuning (optional, defaults shown). DB_MAX_OPEN_CONNS must be at least 2.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m
# DB_CONNECT_TIMEOUT=30s

# --- postgres container (compose `db` service only, must match DATABASE_URL) ---
POSTGRES_USER=evgame
POSTGRES_PASSWORD=evgame
POSTGRES_DB=evgame
